<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- the project is named OpenTelemetry, same as the package it references.
         add Sample suffix here to resolve.
         -->
    <PackageId>OpenTelemetrySample</PackageId>
    <AssemblyName>OpenTelemetrySample</AssemblyName>
    <RootNamespace>OpenTelemetrySample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    <PackageReference Include="OpenTelemetry" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.19.0" />
    <PackageReference Include="SVappsLAB.iRacingTelemetrySDK" Version="2.5.0" />
  </ItemGroup>

</Project>
